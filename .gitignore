# local only: the leak-check denylist never gets committed
.leakcheck
__pycache__/
*.pyc
*.db
*.db-journal
*.db-wal
*.db-shm

# week-video: renders and build folders stay local
examples/week-video/**/*.mp4
examples/week-video/**/node_modules/
examples/week-video/**/renders/
examples/week-video/build/
examples/week-video/**/.work/
